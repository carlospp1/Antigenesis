# Caché del navegador (Netlify). Los modelos 3D y las imágenes se guardan un día y, después, se siguen usando
# mientras se comprueba en segundo plano si hay versión nueva. Lo compilado lleva huella en el nombre: no cambia nunca.
/models/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000
/bg/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/sw.js
  Cache-Control: no-cache
